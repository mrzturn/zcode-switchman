{
  "$comment": "Example shell matrix for zcode-switchman. Copy to config/matrix.json and fill in your own pools/models. NOTHING in this file is bound to any real provider — names like alpha/beta/gamma are placeholders.",

  "pools": {
    "alpha": {
      "label": "Subscription pool A (usage-quota plan)",
      "paid": false,
      "quotaFile": "alpha-quota.json",
      "exhaustedPct": 100,
      "hotPct": 80
    },
    "beta": {
      "label": "Subscription pool B (credit bucket)",
      "paid": false,
      "quotaFile": "beta-quota.json",
      "exhaustedPct": 100,
      "hotPct": 80,
      "overagePermitted": false
    },
    "payg": {
      "label": "Pay-as-you-go fallback",
      "paid": true,
      "quotaFile": null
    }
  },

  "families": ["alpha", "beta", "gamma"],

  "roleRouting": {
    "planner":   ["beta", "alpha", "payg"],
    "reviewer":  ["beta", "alpha", "payg"],
    "programmer": ["alpha", "beta", "payg"],
    "tester":    ["alpha", "beta", "payg"],
    "uiux":      ["alpha", "beta", "payg"],
    "data-analyst": ["alpha", "beta", "payg"],
    "ops":       ["alpha", "beta", "payg"],
    "scouter":   ["beta", "alpha", "payg"],
    "clerk":     ["beta", "alpha", "payg"],
    "observer":  ["alpha", "beta", "payg"]
  },

  "shells": [
    { "name": "alpha-mx-model-a-low",   "pool": "alpha", "family": "alpha", "model": "custom:REPLACE_ME", "thoughtLevel": "low",   "capability": "rw", "modalities": ["text"] },
    { "name": "alpha-mx-model-a-high",  "pool": "alpha", "family": "alpha", "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "rw", "modalities": ["text"] },
    { "name": "alpha-mx-model-a-xhigh", "pool": "alpha", "family": "alpha", "model": "custom:REPLACE_ME", "thoughtLevel": "xhigh", "capability": "rw", "modalities": ["text"] },
    { "name": "alpha-mx-model-a-vision","pool": "alpha", "family": "alpha", "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "rw", "modalities": ["text", "image"] },
    { "name": "beta-mx-model-b-high",   "pool": "beta",  "family": "beta",  "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "rw", "modalities": ["text"] },
    { "name": "beta-mx-model-b-xhigh",  "pool": "beta",  "family": "beta",  "model": "custom:REPLACE_ME", "thoughtLevel": "xhigh", "capability": "rw", "modalities": ["text"] },
    { "name": "beta-mx-model-b-ro",     "pool": "beta",  "family": "beta",  "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "ro", "modalities": ["text"] },
    { "name": "gamma-mx-model-g-ro",    "pool": "beta",  "family": "gamma", "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "ro", "modalities": ["text"] },
    { "name": "payg-mx-model-p-high",   "pool": "payg",  "family": "gamma", "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "rw", "modalities": ["text"] },
    { "name": "payg-mx-model-p-vision", "pool": "payg",  "family": "gamma", "model": "custom:REPLACE_ME", "thoughtLevel": "high",  "capability": "rw", "modalities": ["text", "image"] }
  ],

  "lanes": {
    "economy":    ["alpha-mx-model-a-low", "payg-mx-model-p-high"],
    "mechanical": ["alpha-mx-model-a-high", "beta-mx-model-b-high", "payg-mx-model-p-high"],
    "main":       ["alpha-mx-model-a-high", "beta-mx-model-b-high", "payg-mx-model-p-high"],
    "hard":       ["alpha-mx-model-a-xhigh", "beta-mx-model-b-xhigh", "payg-mx-model-p-high"],
    "vision":     ["alpha-mx-model-a-vision", "payg-mx-model-p-vision"],
    "review":     ["gamma-mx-model-g-ro", "beta-mx-model-b-ro"]
  }
}
