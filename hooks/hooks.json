{
  "description": "zcode-switchman routing hooks: session banner, language gate, dispatch gate, failure breaker, context write-guard, shell context guard, code-comment format iron rule.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/session-start.mjs"],
            "timeoutMs": 10000,
            "statusMessage": "zcode-switchman: rendering routing banner…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/user-prompt-submit.mjs"],
            "timeoutMs": 3000,
            "statusMessage": "zcode-switchman: applying project rules…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Write|Edit|MultiEdit|NotebookEdit|Bash|Read|Glob|Grep|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/pre-tool-use.mjs"],
            "timeoutMs": 3000,
            "statusMessage": "zcode-switchman: checking gates…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/lang-capture.mjs"],
            "timeoutMs": 3000,
            "statusMessage": "zcode-switchman: capturing language preference…"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/post-tool-failure.mjs"],
            "timeoutMs": 3000,
            "statusMessage": "zcode-switchman: recording dispatch failure…"
          }
        ]
      }
    ]
  }
}
